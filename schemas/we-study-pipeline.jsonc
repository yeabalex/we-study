    "messages": [
      {
        "messageId": "msg_001",
        "role": "user",
        "content": "Why is PFK-1 inhibited by high ATP if ATP is also a substrate?",
        "timestamp": "2026-09-09T15:40:00Z"
      },
      {
        "messageId": "msg_002",
        "role": "assistant",
        "content": "ATP has two binding sites on PFK-1: a high-affinity catalytic active site and a low-affinity allosteric regulatory site. When cellular ATP is high, it binds the allosteric site to downregulate the pathway.",
        "timestamp": "2026-09-09T15:40:04Z"
      }
    ]
  }
